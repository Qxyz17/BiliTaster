{
  "manifest_version": 2,
  "name": "BiliTaster",
  "version": "0.1.0",
  "description": "在哔哩哔哩页面调用自定义 AI 总结/对话视频",
  "permissions": [
    "storage",
    "activeTab",
    "https://*.bilibili.com/*",
    "https://token.sensenova.cn/*",
    "https://*.sensenova.cn/*",
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "scripts": ["src/background.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["*://*.bilibili.com/video/*"],
      "js": ["src/content.js"],
      "css": ["src/panel.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}